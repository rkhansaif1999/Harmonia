# 1. Catch-all rules (MUST be at the top for Cloudflare Pages)
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# 2. HTML pages: never cache, always fetch the latest version from the server
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# 3. Versioned static assets (style.css?v=..., script.js?v=...)
# Cached for 1 year. When you bump the ?v= number, browsers instantly fetch the new file.
/style.css
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=31536000, immutable

# 4. Robots tags for specific pages
/admin-dashboard.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/worker-dashboard.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/worker-bonus-tasks.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

/admin-login.html
  X-Robots-Tag: noindex, nofollow, noarchive

/discord-callback.html
  X-Robots-Tag: noindex, nofollow, noarchive

/offerwall-launch.html
  X-Robots-Tag: noindex, nofollow, noarchive

